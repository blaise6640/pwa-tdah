{
  "name": "my-pwa-template",
  "private": true,
  "version": "0.0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync-config": "node scripts/sync-config.cjs",
    "predeploy:dev": "npm run sync-config",
    "build:dev": "cross-env NODE_ENV=development vite build --mode development",
    "deploy:dev": "npm run build:dev && firebase deploy --project pwa-tdah",
    "deploy:dev:h": "npm run build:dev && firebase deploy --only hosting --project pwa-tdah",
    "predeploy:dev:f": "npm run sync-config",
    "deploy:dev:f": "firebase deploy --only functions --project pwa-tdah",
    "build:prod": "vite build --mode production",
    "predeploy:prod": "npm run sync-config",
    "deploy:prod": "npm run build:prod && firebase deploy --project pwa-tdah",
    "deploy:prod:h": "npm run build:prod && firebase deploy --only hosting  --project pwa-tdah",
    "predeploy:prod:f": "npm run sync-config",
    "deploy:prod:f": "npm run build:prod && firebase deploy --only functions  --project pwa-tdah",
    "seed:dev": "node emulator-data/dev-seed.json",
    "test": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/press-start-2p": "^5.2.7",
    "@mui/icons-material": "^7.0.2",
    "@mui/system": "^7.3.3",
    "axios": "^1.20.0",
    "browser-image-compression": "^2.0.2",
    "dayjs": "^1.11.18",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.3.0",
    "firestore-export-import": "^1.6.0",
    "firestore-seed": "^0.0.11",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "node-fetch": "^3.3.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^7.18.6",
    "recharts": "^2.15.4",
    "source-map": "^0.7.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@mui/material": "^7.3.4",
    "@mui/types": "^7.4.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "baseline-browser-mapping": "^2.11.38",
    "cross-env": "^10.1.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^27.2.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "ts-node": "^10.9.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.11"
  }
}
