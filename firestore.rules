rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Role checks
    function isParent() {
      return isAuthenticated() && getUserData().get('role', '') == 'Parent';
    }
    
    function isChild() {
      return isAuthenticated() && getUserData().get('role', '') == 'Child';
    }
    
    // ============================================
    // USERS - Profile Access
    // ============================================
    
    match /users/{userId} {
      allow read: if isAuthenticated(); // All auth users can read profiles (to see names)
      allow write: if isAuthenticated() && request.auth.uid == userId; // Users manage their own profile
      
      // Parent can manage all users (e.g. set roles)
      allow write: if isParent();

      // FCM tokens subcollection: allow users to create/read their own tokens
      match /fcmTokens/{tokenId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isParent());
        allow create, update, delete: if isAuthenticated() && (request.auth.uid == userId || isParent());
      }
    }
    
    // ============================================
    // TASKS COLLECTION
    // ============================================
    
    match /tasks/{taskId} {
      // Parent: Full Access
      allow read, write: if isParent();
      
      // Child:
      // - Create: Yes
      // - Read: Yes (all tasks? or only assigned? Requirements say "Parent manages all, Child creates/deletes own". Let's allow read all for simplicity and transparency)
      allow read: if isChild();
      
      allow create: if isChild() && request.resource.data.createdByUid == request.auth.uid;
      
      allow update: if isChild() 
                    // Can update status (mark done)
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
                    
      allow delete: if isChild() && resource.data.createdByUid == request.auth.uid;
    }
    
    // ============================================
    // TASK SERIES (Recurrence)
    // ============================================
    match /taskSeries/{seriesId} {
       // Parent manages recurrence
       allow read, write: if isParent();
       
       // Child can read to see schedule
       allow read: if isChild();
    }
  }
}